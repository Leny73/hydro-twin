# Frontend Environment Variables
# ================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it contains secrets.

# ── Mapbox ────────────────────────────────────────────────────────────────────
# Public access token from https://account.mapbox.com/
# Create a token scoped to: styles:read, tiles:read
VITE_MAPBOX_TOKEN=pk.YOUR_TOKEN_HERE

# ── API Gateway ───────────────────────────────────────────────────────────────
# Your deployed AWS API Gateway URL (REST or HTTP API)
# Example: https://abc123def.execute-api.us-east-1.amazonaws.com/prod/assess
VITE_API_ENDPOINT=https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com/prod/assess
