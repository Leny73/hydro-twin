# Backend Environment Variables — set these in AWS Lambda Console → Configuration → Environment variables
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS=

# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it contains secrets.

# ── Discord ───────────────────────────────────────────────────────────────────
# Webhook URL from Discord: Server Settings → Integrations → Webhooks → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ── Telegram ──────────────────────────────────────────────────────────────────
# Bot token from @BotFather → /newbot
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
# Your personal or channel chat ID (use @userinfobot to find yours)
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
# Alternatives: anthropic.claude-3-haiku-20240307-v1:0  (fastest, cheapest)
#               anthropic.claude-3-opus-20240229-v1:0   (most capable)
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_REGION=us-east-1

# ── AWS credentials (local dev only — not needed in Lambda) ───────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Sentinel Hub OAuth2 credentials ───────────────────────────────────────────
# Get from: https://shapps.sentinel-hub.com → User Settings → OAuth Clients → + Create
# Scope needed: none (client_credentials grant is sufficient)
SH_CLIENT_ID=
SH_CLIENT_SECRET=

# ── DynamoDB ──────────────────────────────────────────────────────────────────
# Table that stores Subscribe-to-Alerts records (subscribe_handler.py)
# PK = email (S), SK = region_id (S)
# Optional attributes: discord_webhook (S), phone (S), telegram_chat (S)
SUBSCRIPTIONS_TABLE=HydroTwinSubscriptions

# ── Brevo (transactional email) ───────────────────────────────────────────────
# Sign up: https://www.brevo.com → Settings → SMTP & API → API Keys → Create
# Sender email MUST be verified under Settings → Senders, Domains & Dedicated IPs
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=HydroTwin

# ── Frontend deep links + unsubscribe ─────────────────────────────────────────
# Used to build the URLs that go inside emails. Local dev: http://localhost:5173
FRONTEND_BASE_URL=https://hydrotwin.vercel.app
# Secret used to HMAC-sign one-click unsubscribe tokens. Rotate this and every
# previously-issued unsubscribe link is invalidated, so change with care.
UNSUBSCRIBE_SECRET=replace-with-a-long-random-string

# ── SMS (AWS SNS) — disabled by default ───────────────────────────────────────
# Phone numbers are accepted + stored at subscribe time, but actual SMS
# delivery only fires once the AWS lead has moved this account out of the SNS
# SMS sandbox (or has verified each demo number inside the sandbox).
# Flip SMS_ENABLED=1 to start delivering.
SMS_ENABLED=
SMS_REGION=eu-west-1
