# Backend Environment Variables — set these in AWS Lambda Console → Configuration → Environment variables
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS=

# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git — it contains secrets.

# ── Discord ───────────────────────────────────────────────────────────────────
# Webhook URL from Discord: Server Settings → Integrations → Webhooks → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ── Telegram ──────────────────────────────────────────────────────────────────
# Bot token from @BotFather → /newbot
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
# Your personal or channel chat ID (use @userinfobot to find yours)
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# ── AWS Bedrock ───────────────────────────────────────────────────────────────
# Alternatives: anthropic.claude-3-haiku-20240307-v1:0  (fastest, cheapest)
#               anthropic.claude-3-opus-20240229-v1:0   (most capable)
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_REGION=us-east-1

# ── AWS credentials (local dev only — not needed in Lambda) ───────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# ── Sentinel Hub OAuth2 credentials ───────────────────────────────────────────
# Get from: https://shapps.sentinel-hub.com → User Settings → OAuth Clients → + Create
# Scope needed: none (client_credentials grant is sufficient)
SH_CLIENT_ID=
SH_CLIENT_SECRET=
