# Backend Environment Variables — set these in AWS Lambda Console → Configuration → Environment variables
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS=


# Discord or Telegram webhook URL
# Discord  : https://discord.com/api/webhooks/<WEBHOOK_ID>/<WEBHOOK_TOKEN>
# Telegram : https://api.telegram.org/bot<BOT_TOKEN>/sendMessage
WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# AWS Bedrock model identifier (Claude 3 Sonnet recommended for speed/cost balance)
# Alternatives: anthropic.claude-3-haiku-20240307-v1:0  (fastest, cheapest)
#               anthropic.claude-3-opus-20240229-v1:0   (most capable)
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# AWS region where Bedrock is enabled on your account
BEDROCK_REGION=us-east-1

# DynamoDB table that stores Subscribe-to-Alerts records (subscribe_handler.py)
# PK = email (S), SK = region_id (S)
SUBSCRIPTIONS_TABLE=HydroTwinSubscriptions
